{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0"
  },
  "permissions": {
    "allow": [
      "Read(//Users/alexzajac/projects/strategy-game/**)",
      "Bash(gh label:*)",
      "Bash(pnpm type-check:*)",
      "Bash(pnpm format:check)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm format:*)",
      "Bash(git log:*)",
      "Skill(playdate-sdk)",
      "Skill(playdate-sdk:*)",
      "Bash(make test:*)",
      "Bash(make -C c test)",
      "Bash(make -C c lint)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$CLAUDE_FILE_PATHS\" | grep -qE '\\.(c|h)$'; then make -C /Users/alexzajac/projects/finch format 2>&1; fi",
            "statusMessage": "Formatting C files"
          }
        ]
      }
    ]
  }
}
